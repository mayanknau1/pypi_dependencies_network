{"info": {"author": null, "author_email": "Kelsey Jordahl <kjordahl@alum.mit.edu>", "bugtrack_url": null, "classifiers": ["Development Status :: 5 - Production/Stable", "Intended Audience :: Science/Research", "Operating System :: OS Independent", "Programming Language :: Python :: 3", "Programming Language :: Python :: 3 :: Only", "Topic :: Scientific/Engineering :: GIS"], "description": "GeoPandas is a project to add support for geographic data to\n`pandas`_ objects.\n\nThe goal of GeoPandas is to make working with geospatial data in\npython easier. It combines the capabilities of `pandas`_ and `shapely`_,\nproviding geospatial operations in pandas and a high-level interface\nto multiple geometries to shapely. GeoPandas enables you to easily do\noperations in python that would otherwise require a spatial database\nsuch as PostGIS.\n\n.. _pandas: https://pandas.pydata.org\n.. _shapely: https://shapely.readthedocs.io/en/latest/\n", "description_content_type": "text/x-rst", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": null, "home_page": null, "keywords": "GIS, cartography, pandas, shapely", "license": null, "license_expression": "BSD-3-Clause", "license_files": ["LICENSE.txt"], "maintainer": "GeoPandas contributors", "maintainer_email": null, "name": "geopandas", "package_url": "https://pypi.org/project/geopandas/", "platform": null, "project_url": "https://pypi.org/project/geopandas/", "project_urls": {"Home": "https://geopandas.org", "Repository": "https://github.com/geopandas/geopandas"}, "provides_extra": ["all"], "release_url": "https://pypi.org/project/geopandas/1.2.0/", "requires_dist": ["numpy>=2", "packaging", "pandas>=2.2.0", "pyogrio>=0.8", "pyproj>=3.7.0", "shapely>=2.1.0", "contextily; extra == \"all\"", "folium; extra == \"all\"", "geoalchemy2; extra == \"all\"", "geopy; extra == \"all\"", "mapclassify>=2.7; extra == \"all\"", "matplotlib>=3.9; extra == \"all\"", "pointpats>=2.5.3; 
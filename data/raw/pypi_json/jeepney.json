{"info": {"author": null, "author_email": "Thomas Kluyver <thomas@kluyver.me.uk>", "bugtrack_url": null, "classifiers": ["Programming Language :: Python :: 3", "Topic :: Desktop Environment"], "description": "Jeepney is a pure Python implementation of D-Bus messaging. It has an `I/O-free\n<https://sans-io.readthedocs.io/>`__ core, and integration modules for different\nevent loops.\n\nD-Bus is an inter-process communication system, mainly used in Linux.\n\nTo install Jeepney::\n\n    pip install jeepney\n\n`Jeepney docs on Readthedocs <https://jeepney.readthedocs.io/en/latest/>`__\n\n", "description_content_type": "text/x-rst", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": null, "home_page": null, "keywords": null, "license": null, "license_expression": "MIT", "license_files": ["LICENSE"], "maintainer": null, "maintainer_email": null, "name": "jeepney", "package_url": "https://pypi.org/project/jeepney/", "platform": null, "project_url": "https://pypi.org/project/jeepney/", "project_urls": {"Documentation": "https://jeepney.readthedocs.io/en/latest/", "Source": "https://gitlab.com/takluyver/jeepney"}, "provides_extra": ["test", "trio"], "release_url": "https://pypi.org/project/jeepney/0.9.0/", "requires_dist": ["pytest; extra == \"test\"", "pytest-trio; extra == \"test\"", "pytest-asyncio>=0.17; extra == \"test\"", "testpath; extra == \"test\"", "trio; extra == \"test\"", "async-timeout; extra == \"test\" and python_version < \"3.11\"", "trio; extra == \"trio\""], "requires_python": ">=3.7", "summary": "Low-level, pure Python DBus protocol wrapper.", "version": "0.9.0", "yanked": false, "yanked_reason": null}, "release_dates": {"0.1": "2017-02-26T16:48:53.105245Z", "0.2": "2017-05-28T12:05:38.372803Z", "0.3": "2017-05-29T14:50:22.874045Z", "0.3.1": "2017-05-29T16:53:22.254752Z", "0.4": "2018-09-24T10:32:47.462155Z", "0.4.1": "2019-08-11T11:04:35.613072Z", "0.4.2": "2020-01-03T18:41:06.562274Z", "0
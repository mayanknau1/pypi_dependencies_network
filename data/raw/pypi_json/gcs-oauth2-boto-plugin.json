{"info": {"author": "Google Inc.", "author_email": "gs-team@google.com", "bugtrack_url": null, "classifiers": ["Development Status :: 7 - Inactive", "Intended Audience :: Developers", "License :: OSI Approved :: Apache Software License", "Programming Language :: Python :: 2", "Programming Language :: Python :: 2.7", "Programming Language :: Python :: 3", "Programming Language :: Python :: 3.4", "Programming Language :: Python :: 3.5", "Programming Language :: Python :: 3.6", "Programming Language :: Python :: 3.7", "Topic :: Internet :: WWW/HTTP", "Topic :: Software Development :: Libraries :: Python Modules"], "description": "\ngcs-oauth2-boto-plugin is a Python application whose purpose is to behave as an\nauth plugin for the boto auth plugin framework for use with OAuth 2.0\ncredentials for the Google Cloud Platform. This plugin is compatible with both\nuser accounts and service accounts, and its functionality is essentially a\nwrapper around oauth2client with the addition of automatically caching tokens\nfor the machine in a thread- and process-safe fashion.\n", "description_content_type": null, "docs_url": null, "download_url": "https://github.com/GoogleCloudPlatform/gcs-oauth2-boto-plugin", "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": ["Author", "Author-Email", "Classifier", "Description", "Download-Url", "Home-Page", "License", "License-File", "Platform", "Provides-Extra", "Requires-Dist", "Summary"], "home_page": "https://developers.google.com/storage/docs/gspythonlibrary", "keywords": null, "license": "Apache 2.0", "license_expression": null, "license_files": ["LICENSE"], "maintainer": null, "maintainer_email": null, "name": "gcs-oauth2-boto-plugin", "package_url": "https://pypi.org/project/gcs-oauth2-boto-plugin/", "platform": "any", "project_url": "https://pypi.org/project/gcs-oauth2-boto-plugin/", "project_urls": {"Download": "https://github.com/GoogleCloudPlatform/gcs-oauth2-boto-plugin", "Homepage": "https://developers.g
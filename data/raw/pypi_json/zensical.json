{"info": {"author": null, "author_email": "Zensical <contributors@zensical.org>", "bugtrack_url": null, "classifiers": ["Development Status :: 4 - Beta", "Environment :: Web Environment", "License :: OSI Approved :: MIT License", "Programming Language :: Python", "Programming Language :: Python :: 3.11", "Programming Language :: Python :: 3.12", "Programming Language :: Python :: 3.13", "Programming Language :: Python :: 3.14", "Programming Language :: Python :: 3.15", "Programming Language :: Rust", "Topic :: Documentation", "Topic :: Software Development :: Documentation", "Topic :: Text Processing :: Markup :: HTML", "Topic :: Text Processing :: Markup :: Markdown"], "description": "<p align=\"center\">\n  <picture>\n    <source media=\"(prefers-color-scheme: dark)\" srcset=\"https://raw.githubusercontent.com/zensical/zensical/master/.github/assets/zensical-dark.png\">\n    <source media=\"(prefers-color-scheme: light)\" srcset=\"https://raw.githubusercontent.com/zensical/zensical/master/.github/assets/zensical.png\">\n    <img alt=\"Zensical\" src=\"https://raw.githubusercontent.com/zensical/zensical/master/.github/assets/zensical.png\" width=\"290\" height=\"240\">\n  </picture>\n</p>\n\n<p align=\"center\">\n  <strong>\n    A modern static site generator built by the creators of\n    <a href=\"https://github.com/squidfunk/mkdocs-material/\">Material for MkDocs</a>\n  </strong>\n</p>\n\n<p align=\"center\">\n  <a href=\"https://github.com/zensical/zensical/actions\"><img\n    src=\"https://github.com/zensical/zensical/actions/workflows/build.yml/badge.svg\"\n    alt=\"Build\"\n  /></a>\n  <a href=\"https://pypistats.org/packages/zensical\"><img\n    src=\"https://img.shields.io/pypi/dm/zensical.svg\"\n    alt=\"Downloads\"\n  /></a>\n  <a href=\"https://pypi.org/project/zensical\"><img\n    src=\"https://img.shields.io/pypi/v/zensical?logo=python&logoColor=white&label=PyPI\"\n    alt=\"Python Package Index\"\n  /></a>\n  <a href=\"https://discord.com/invite/hqXRNq9CjT\"><img\n    src=\"https://img.shields.io/discord/1289187620659789824?logo=discord&logoColor=white&label=Discord\"\n    alt=\"Discord\"\n  /></a>\n  <a href=\"https://hub.docker.com/r/zensical/zensical/\"><img\n    src=\"https://img.shields.io/docker/pulls/zensical/zensical\"\n    alt=\"Docker Pulls\"\n  /></a>\n</p>\n\n<p align=\"center\">\n  <a href=\"https://zensical.org/\"><strong>Home</strong></a>\n  &middot;\n  <a href=\"https://zensical.org/docs/get-started/\"><strong>Get started</strong></a>\n  &middot;\n  <a href=\"https://zensical.org/docs/compatibility/mkdocs/\"><strong>Compatibility</strong></a>\n  &middot;\n  <a href=\"https://zensical.org/roadmap/\"><strong>Roadmap</strong></a>\n  &middot;\n  <a href=\"https://zensical.org/about/newsletter/\"><strong>Newsletter</strong></a>\n  &middot;\n  <a href=\"https://zensical.org/studio/\"><strong>Zensical Studio</strong></a>\n</p>\n\n<p align=\"center\">\n  Write your documentation in Markdown and create a professional static site for\n  your Open Source or commercial project in minutes \u2013 searchable, customizable,\n  more than 60 languages, for all devices.\n</p>\n\n<p align=\"center\">\n  <picture>\n    <source media=\"(prefers-color-scheme: dark)\" srcset=\"https://raw.githubusercontent.com/zensical/zensical/master/.github/assets/screenshot-dark.png\">\n    <source media=\"(prefers-color-scheme: light)\" srcset=\"https://raw.githubusercontent.com/zensical/zensical/master/.github/assets/screenshot.png\">\n    <img alt=\"Zensical\" src=\"https://raw.githubusercontent.com/zensical/zensical/master/.github/assets/screenshot.png\">\n  </picture>\n</p>\n\n<p align=\"center\">\n  <em>\n    Visit our documentation at\n    <a href=\"https://zensical.org/docs/\">zensical.org/docs/</a>.\n  </em>\n</p>\n\n## Studio and Spark\n\n[Zensical Studio](https://zensical.org/studio/) helps you author documentation\ncomfortably in Zensical and MkDocs projects, with project-aware editing and\nrefactoring that saves you manual cleanup.\n\n[Zensical Spark](https://zensical.org/spark/memberships/) offers early access\nto new features, a direct voice in our work, and professional support for\norganizations, with options for confidential collaboration and continuity\nplanning. Spark Community opens to individuals on November 5.\n\nBoth are optional. Zensical remains MIT-licensed and free forever.\n\n", "description_content_type": "text/markdown; charset=UTF-8; variant=GFM", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": null, "home_page": "https://github.com/zensical/zensical", "keywords": null, "license": null, "license_expression": "MIT", "license_files": ["LICENSE.md"], "maintainer": null, "maintainer_email": null, "name": "zensical", "package_url": "https://pypi.org/project/zensical/", "platform": null, "project_url": "https://pypi.org/project/zensical/", "project_urls": {"Changelog": "https://zensical.org/docs/changelog/", "Documentation": "https://zensical.org/docs/", "Homepage": "https://zensical.org/", "Issues": "https://github.com/zensical/zensical/issues", "Source": "https://github.com/zensical/zensical/"}, "provides_extra": null, "release_url": "https://pypi.org/project/zensical/0.1.3/", "requires_dist": ["click>=8.1.8", "jinja2>=3.1", "markdown>=3.7", "pathspec>=1.0.4", "pygments>=2.20", "pymdown-extensions>=11.0", "pyyaml>=6.0.2", "tomli>=2.4.0", "zensical-ui==0.0.43"], "requires_python": ">=3.11", "summary": "A modern static site generator built by the creators of Material for MkDocs", "version": "0.1.3", "yanked": false, "yanked_reason": null}, "release_dates": {"0.0.0": "2024-11-25T08:52:19.901363Z", "0.0.1": "2025-05-17T08:40:08.326778Z", "0.0.10": "2025-11-25T20:41:52.917727Z", "0.0.11": "2025-12-03T13:11:39.901441Z", "0.0.12": "2025-12-18T13:19:03.861803Z", "0.0.13": "2025-12-18T20:01:46.083751Z", "0.0.14": "2025-12-21T15:12:09.477171Z", "0.0.15": "2025-12-24T11:15:09.019760Z", "0.0.16": "2026-01-15T
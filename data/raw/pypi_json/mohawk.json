{"info": {"author": "Kumar McMillan, Austin King", "author_email": "kumar.mcmillan@gmail.com", "bugtrack_url": null, "classifiers": ["Intended Audience :: Developers", "Natural Language :: English", "Operating System :: OS Independent", "Programming Language :: Python :: 2", "Programming Language :: Python :: 2.6", "Programming Language :: Python :: 2.7", "Programming Language :: Python :: 3", "Programming Language :: Python :: 3.4", "Programming Language :: Python :: 3.5", "Programming Language :: Python :: 3.6", "Programming Language :: Python :: 3.7", "Topic :: Internet :: WWW/HTTP"], "description": "\nHawk lets two parties securely communicate with each other using\nmessages signed by a shared key.\nIt is based on HTTP MAC access authentication (which\nwas based on parts of OAuth 1.0).\n\nThe Mohawk API is a little different from that of the Node library\n(i.e. https://github.com/hueniverse/hawk).\nIt was redesigned to be more intuitive to developers, less prone to security problems, and more Pythonic.\n\nRead more: https://github.com/kumar303/mohawk/\n\n\n", "description_content_type": "", "docs_url": null, "download_url": "", "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": null, "home_page": "https://github.com/kumar303/mohawk", "keywords": "", "license": "MPL 2.0 (Mozilla Public License)", "license_expression": null, "license_files": null, "maintainer": "", "maintainer_email": "", "name": "mohawk", "package_url": "https://pypi.org/project/mohawk/", "platform": "", "project_url": "https://pypi.org/project/mohawk/", "project_urls": {"Homepage": "https://github.com/kumar303/mohawk"}, "provides_extra": null, "release_url": "https://pypi.org/project/mohawk/1.1.0/", "requires_dist": ["six"], "requires_python": "", "summary": "Library for Hawk HTTP authorization", "version": "1.1.0", "yanked": false, "yanked_reason": null}, "release_dates": {"0.0.1": "2014-02-06T20:19:40.919086Z", "0.0.2": "2014-02-07T00:55:47.509411Z", "0.0.3": "2014-02
{"info": {"author": null, "author_email": null, "bugtrack_url": null, "classifiers": [], "description": "# OCPSVG\n\n- works at the [`OCP`](https://github.com/CadQuery/OCP) level\n- uses [`svgelements`](https://github.com/meerk40t/svgelements) to:\n  - convert SVG path strings to and from `TopoDS_Edge`, `TopoDS_Wire`, and `TopoDS_Face` objects\n  - import `TopoDS_Wire` and `TopoDS_Face` objects from an SVG document\n- can be used to add SVG functionality (import and export) to higher level API\n", "description_content_type": "text/markdown", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": ["License-File"], "home_page": null, "keywords": null, "license": null, "license_expression": null, "license_files": ["LICENSE"], "maintainer": null, "maintainer_email": null, "name": "ocpsvg", "package_url": "https://pypi.org/project/ocpsvg/", "platform": null, "project_url": "https://pypi.org/project/ocpsvg/", "project_urls": null, "provides_extra": ["dev"], "release_url": "https://pypi.org/project/ocpsvg/0.7.0/", "requires_dist": ["cadquery_ocp_proxy<9.0,>=8.0", "svgelements<2,>=1.9.1", "cadquery_ocp_novtk<9.0,>=8.0; extra == \"dev\"", "cadquery-ocp-stubs<9.0,>=8.0; extra == \"dev\"", "pytest; extra == \"dev\"", "coverage; extra == \"dev\"", "mypy; extra == \"dev\"", "ruff; extra == \"dev\""], "requires_python": ">=3.11", "summary": null, "version": "0.7.0", "yanked": false, "yanked_reason": null}, "release_dates": {"0.2.0": "2023-12-04T17:06:05.064237Z", "0.2.1": "2024-05-18T12:44:39.145333Z", "0.3.1": "2024-10-23T16:28:19.050965Z", "0.3.2": "2024-12-03T14:03:43.906229Z", "0.3.3": "2024-12-17T04:50:26.159126Z", "0.3.4": "2025-01-13T11:09:44.360922Z", "0.4.0": "2025-01-13T16:47:03.100217Z", "0.5.0": "2025-02-21T15:54:10.405413Z", "0.6.0": "2026-01-08T12:31:33.804706Z", "0.7.0": "2026-09-12T09:15:21.842742Z"}}
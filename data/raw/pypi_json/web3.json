rove documentation? Excellent! Read up on our\nguidelines for [contributing](https://web3py.readthedocs.io/en/latest/contributing.html),\nthen check out issues that are labeled\n[Good First Issue](https://github.com/ApeWorX/web3.py/issues?q=is%3Aissue+is%3Aopen+label%3A%22Good+First+Issue%22).\n\n______________________________________________________________________\n\n## Questions on Implementation or Usage?\n\nJoin the conversation in the Ethereum Python Community [Discord](https://discord.gg/GHryRvPB84).\n", "description_content_type": "text/markdown", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": ["License-File"], "home_page": null, "keywords": "ethereum", "license": null, "license_expression": "MIT", "license_files": ["LICENSE"], "maintainer": null, "maintainer_email": "ApeWorX Collective <admin@apeworx.io>", "name": "web3", "package_url": "https://pypi.org/project/web3/", "platform": null, "project_url": "https://pypi.org/project/web3/", "project_urls": {"Documentation": "https://web3py.readthedocs.io/", "Funding": "https://github.com/sponsors/ApeWorX", "Homepage": "https://github.com/ApeWorX/web3.py", "Issues": "https://github.com/ApeWorX/web3.py/issues", "Repository": "https://github.com/ApeWorX/web3.py.git"}, "provides_extra": ["tester"], "release_url": "https://pypi.org/project/web3/8.0.0/", "requires_dist": ["aiohttp>=3.7.4.post0", "eth-abi>=6", "eth-account>=0.14", "eth-hash[pycryptodome]>=0.5.1", "eth-typing>=5.0.0", "eth-utils>=5.3.0", "hexbytes>=2", "pydantic>=2.4", "pyunormalize>=15", "pywin32>=223; platform_system == \"Windows\"", "requests>=2.23.0", "typing-extensions>=4.0.1; python_version < \"3.11\"", "websockets>=14", "eth-tester[py-evm]<0.15.0b1,>=0.14.0b1; extra == \"tester\""], "requires_python": "<4,>=3.10", "summary": "web3: A Python library for interacting with Ethereum", "version": "8.0.0", "yanked": false, "yanked_reason": null}, "release_dates": {"0.1.7": "2016-04-28
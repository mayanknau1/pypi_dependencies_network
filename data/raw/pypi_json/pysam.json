{"info": {"author": "Andreas Heger", "author_email": "Andreas Heger <andreas.heger@gmail.com>", "bugtrack_url": null, "classifiers": ["Development Status :: 4 - Beta", "Intended Audience :: Developers", "Intended Audience :: Science/Research", "Operating System :: MacOS", "Operating System :: POSIX", "Operating System :: Unix", "Programming Language :: Python", "Topic :: Scientific/Engineering", "Topic :: Software Development"], "description": "pysam --- a Python package for reading, manipulating, and writing\ngenomic data sets.\n\npysam is a lightweight wrapper of the HTSlib API and provides facilities\nto read and write SAM/BAM/CRAM/VCF/BCF/BED/GFF/GTF/FASTA/FASTQ files\nas well as access to the command-line functionality of samtools and bcftools.\nThe module supports compression and random access through indexing.\n\nThis module provides a low-level wrapper around HTSlib's C API using Cython\nand a high-level API for convenient access to the data within standard genomic\nfile formats.\n", "description_content_type": "text/x-rst", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": ["Author", "Classifier", "Description", "Description-Content-Type", "Home-Page", "License-File", "Platform"], "home_page": "https://github.com/pysam-developers/pysam", "keywords": null, "license": "MIT License", "license_expression": null, "license_files": ["COPYING", "AUTHORS"], "maintainer": null, "maintainer_email": null, "name": "pysam", "package_url": "https://pypi.org/project/pysam/", "platform": "POSIX", "project_url": "https://pypi.org/project/pysam/", "project_urls": {"Documentation": "https://pysam.readthedocs.io/", "Homepage": "https://github.com/pysam-developers/pysam", "Release notes": "https://pysam.readthedocs.io/en/stable/release.html"}, "provides_extra": null, "release_url": "https://pypi.org/project/pysam/0.24.1/", "requires_dist": null, "requires_python": ">=3.9", "summary": "Package for reading, manipul
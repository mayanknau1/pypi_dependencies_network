{"info": {"author": null, "author_email": "Andrey Golovizin <ag@sologoc.com>", "bugtrack_url": null, "classifiers": ["Development Status :: 4 - Beta", "Environment :: Console", "Intended Audience :: End Users/Desktop", "Operating System :: OS Independent", "Programming Language :: Python", "Programming Language :: Python :: 3", "Topic :: Text Processing :: Markup :: LaTeX", "Topic :: Text Processing :: Markup :: XML", "Topic :: Utilities"], "description": "BibTeX-compatible bibliography processor in Python\n==================================================\n\nSynopsis\n--------\n\n::\n\n    latex foo.tex\n    pybtex foo.aux\n    latex foo.tex\n    latex foo.tex\n\n\nDescription\n-----------\n\nPybtex reads citation information from a file and\nproduces a formatted bibliography. BibTeX style files are supported.\nAlternatively it is possible to write styles in Python.\n\nPybtex currently understands the following bibliography formats:\n\n- BibTeX\n\n- BibTeXML\n\n- YAML-based format\n\nThe resulting bibliography may be output in one of the following formats\n(not supported by legacy BibTeX styles):\n\n- LaTeX\n\n- HTML\n\n- markdown\n\n- plain text\n\n\nSee also\n--------\n\n- `Home page <https://pybtex.org/>`_\n\n- `Pybtex at Codeberg <https://codeberg.org/pybtex/pybtex>`_\n\n- `Pybtex at PyPI <https://pypi.org/project/pybtex>`_\n", "description_content_type": "text/x-rst", "docs_url": "https://pythonhosted.org/pybtex/", "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": null, "home_page": null, "keywords": null, "license": null, "license_expression": "MIT", "license_files": ["COPYING"], "maintainer": null, "maintainer_email": null, "name": "pybtex", "package_url": "https://pypi.org/project/pybtex/", "platform": null, "project_url": "https://pypi.org/project/pybtex/", "project_urls": {"Bug tracker": "https://codeberg.org/pybtex/pybtex/issues", "Changelog": "https://docs.pybtex.org/history.html", "Documentation": "https://docs.pybtex.org/", "Homepage": "https://pybtex.org/", "Repository": "https://codeberg.org/pybtex/pybtex"}, "provides_extra": null, "release_url": "https://pypi.org/project/pybtex/0.26.1/", "requires_dist": ["importlib-metadata; python_version < \"3.10\"", "latexcodec>=1.0.4", "pyyaml>=3.01"], "requires_python": ">=3.8", "summary": "A BibTeX-compatible bibliography processor in Python", "version": "0.26.1", "yanked": false, "yanked_reason": null}, "release_dates": {"0.10": "2009-08-24T12:02:39.301759Z", "0.11": "2009-09-07T16:12:49.394649Z", "0.12": "2009-11-21T19:37:05.551996Z", "0.13.1": "2010-02-18T19:15:58.136317Z", "0.13.2": "2010-02-26T16:50:27.826586Z", "0.14": "2010-09-20T12:23:52.923860Z", "0.14.1": "2010-09-30T11:37:53.651437Z", "0.15": "2011-02-01T20:08:11.965349Z", "0.16": "2012-03-17T11:55:12.078192Z", "0.17": "2014-03-10T19:49:09.330767Z", "0.18": "2014-07-06T18:40:11.603576Z", "0.19": "2015-10-26T09:09:21.352239Z", "0.20": "2016-03-10T11:23:01.480586Z", "0.20.1": "2016-03-17T17:34:44.336830Z", "0.21": "2017-01-20T20:59:46.975284Z", "0.22.0": "2018-11-18T13:42:43.195804Z", "0.22.1": "2019-01-16T16:53:56.990173Z", "0.22.2": "2019-01-17T15:23:21.343403Z", "0.23.0": "2020-10-12T15:37:46.545217Z", "0.24.0": "2021-01-17T20:02:23.696651Z", "0.25.0": "2025-06-21T12:03:27.236021Z", "0.25.1": "2025-06-26T13:27:41.903184Z", "0.26.0": "2026-04-02T15:14:43.570315Z", "0.26.1": "2026-04-03T13:05:39.014188Z", "0.9": "2009-08-17T11:15:13.569099Z"}}
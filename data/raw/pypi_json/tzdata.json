{"info": {"author": "Python Software Foundation", "author_email": "datetime-sig@python.org", "bugtrack_url": null, "classifiers": ["Development Status :: 5 - Production/Stable", "Intended Audience :: Developers", "Programming Language :: Python :: 2", "Programming Language :: Python :: 3"], "description": "tzdata: Python package providing IANA time zone data\n====================================================\n\nThis is a Python package containing ``zic``-compiled binaries for the IANA time\nzone database. It is intended to be a fallback for systems that do not have\nsystem time zone data installed (or don't have it installed in a standard\nlocation), as a part of `PEP 615 <https://www.python.org/dev/peps/pep-0615/>`_.\n\nThis repository generates a ``pip``-installable package, published on PyPI as\n`tzdata <https://pypi.org/project/tzdata>`_.\n\nFor more information, see `the documentation <https://tzdata.python.org>`_.\n", "description_content_type": "text/x-rst", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": ["License-File"], "home_page": "https://github.com/python/tzdata", "keywords": null, "license": "Apache-2.0", "license_expression": null, "license_files": ["LICENSE", "licenses/LICENSE_APACHE"], "maintainer": null, "maintainer_email": null, "name": "tzdata", "package_url": "https://pypi.org/project/tzdata/", "platform": null, "project_url": "https://pypi.org/project/tzdata/", "project_urls": {"Bug Reports": "https://github.com/python/tzdata/issues", "Documentation": "https://tzdata.python.org", "Homepage": "https://github.com/python/tzdata", "Source": "https://github.com/python/tzdata"}, "provides_extra": null, "release_url": "https://pypi.org/project/tzdata/2026.6/", "requires_dist": null, "requires_python": ">=2", "summary": "Provider of IANA time zone data", "version": "2026.6", "yanked": false, "yanked_reason": null}, "release_dates": {"1.2016.5a1": "2016-08-20T17:13:36.712550Z", "1.
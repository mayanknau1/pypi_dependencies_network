CENSE"], "maintainer": null, "maintainer_email": null, "name": "pylsqpack", "package_url": "https://pypi.org/project/pylsqpack/", "platform": null, "project_url": "https://pypi.org/project/pylsqpack/", "project_urls": {"documentation": "https://pylsqpack.readthedocs.io/", "homepage": "https://github.com/aiortc/pylsqpack"}, "provides_extra": null, "release_url": "https://pypi.org/project/pylsqpack/1.1.1/", "requires_dist": null, "requires_python": ">=3.11", "summary": "Python wrapper for the ls-qpack QPACK library", "version": "1.1.1", "yanked": false, "yanked_reason": null}, "release_dates": {"0.1.0": "2019-06-22T22:24:04.336822Z", "0.1.1": "2019-06-24T21:20:25.851766Z", "0.2.0": "2019-07-22T07:37:52.937692Z", "0.2.1": "2019-08-19T07:37:11.077059Z", "0.2.2": "2019-09-04T13:57:00.154260Z", "0.2.3": "2019-09-04T15:15:33.034340Z", "0.2.4": "2019-09-05T19:08:49.758817Z", "0.2.5": "2019-10-08T19:38:03.770528Z", "0.3.0": "2019-10-09T06:59:14.038783Z", "0.3.1": "2019-10-22T06:39:04.239035Z", "0.3.10": "2020-05-25T22:59:41.924689Z", "0.3.11": "2020-10-15T08:00:54.698302Z", "0.3.12": "2021-02-14T00:12:46.043000Z", "0.3.13": "2021-10-27T16:44:16.884511Z", "0.3.14": "2022-02-02T16:56:40.404134Z", "0.3.15": "2022-03-27T10:29:59.081206Z", "0.3.16": "2022-03-29T22:57:50.682694Z", "0.3.17": "2023-04-02T19:20:23.690142Z", "0.3.18": "2023-11-04T19:16:53.996391Z", "0.3.19": "2025-02-02T16:36:34.658835Z", "0.3.2": "2019-10-30T11:24:38.250226Z", "0.3.20": "2025-04-06T15:44:32.913940Z", "0.3.21": "2025-05-11T12:00:33.541452Z", "0.3.22": "2025-05-11T13:18:23.936315Z", "0.3.23": "2025-10-10T17:12:44.892445Z", "0.3.24": "2026-03-29T15:42:25.436008Z", "0.3.3": "2019-10-30T17:25:54.327290Z", "0.3.4": "2019-10-31T09:25:11.005808Z", "0.3.5": "2020-01-18T23:08:40.311234Z", "0.3.6": "2020-03-07T09:06:03.190353Z", "0.3.7": "2020-03-07T14:09:17.466490Z", "0.3.8": "2020-03-10T00:39:50.650269Z", "0.3.9": "2020-03-10T07:23:06.730778Z", "1.0.0": "2026-10-11T09:53:12.336287Z", "1.1.0": "2026-11-11T01:0
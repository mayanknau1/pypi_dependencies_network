{"info": {"author": "Petter Strandmark", "author_email": "petter.strandmark@gmail.com", "bugtrack_url": null, "classifiers": [], "description": "\nPython wrapper around https://bellard.org/quickjs/ .\n\nTranslates types like `str`, `float`, `bool`, `list`, `dict` and combinations\nthereof to and from Javascript.\n\nQuickJS is currently thread-hostile, so this wrapper makes sure that all calls\nto the same JS runtime comes from the same thead.\n", "description_content_type": "", "docs_url": null, "download_url": "", "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": null, "home_page": "https://github.com/PetterS/quickjs", "keywords": "", "license": "", "license_expression": null, "license_files": null, "maintainer": "Quentin Wenger", "maintainer_email": "matpi@protonmail.ch", "name": "quickjs", "package_url": "https://pypi.org/project/quickjs/", "platform": null, "project_url": "https://pypi.org/project/quickjs/", "project_urls": {"Homepage": "https://github.com/PetterS/quickjs"}, "provides_extra": null, "release_url": "https://pypi.org/project/quickjs/1.19.4/", "requires_dist": null, "requires_python": "", "summary": "Wrapping the quickjs C library.", "version": "1.19.4", "yanked": false, "yanked_reason": null}, "release_dates": {"1.0.10": "2019-07-15T19:47:48.767422Z", "1.0.4": "2019-07-15T07:42:03.733218Z", "1.0.5": "2019-07-15T07:43:16.454638Z", "1.0.7": "2019-07-15T10:14:19.563592Z", "1.0.8": "2019-07-15T10:25:34.733081Z", "1.0.9": "2019-07-15T17:33:05.063483Z", "1.1.0": "2019-07-15T21:03:15.738987Z", "1.1.1": "2019-07-15T21:13:32.043499Z", "1.10.0": "2020-01-30T12:23:08.398572Z", "1.11.0": "2020-03-16T21:26:16.486320Z", "1.12.0": "2020-05-04T07:04:46.647188Z", "1.13.0": "2020-08-04T14:25:02.238313Z", "1.14.0": "2020-09-30T08:42:54.306030Z", "1.14.1": "2020-10-07T12:05:46.020896Z", "1.14.2": "2020-10-07T12:31:32.113382Z", "1.15.0": "2020-10-14T14:57:05.320234Z", "1.15.1": "2020-10-25T18:32:17.406205Z", "1.16.0": "2021-03-30T14:16:04.041
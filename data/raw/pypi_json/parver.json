{"info": {"author": null, "author_email": "Frazer McLean <frazer@frazermclean.co.uk>", "bugtrack_url": null, "classifiers": ["Development Status :: 5 - Production/Stable", "Intended Audience :: Developers", "Programming Language :: Python :: 3 :: Only", "Programming Language :: Python :: 3.10", "Programming Language :: Python :: 3.11", "Programming Language :: Python :: 3.12", "Programming Language :: Python :: 3.13", "Programming Language :: Python :: 3.14", "Programming Language :: Python :: 3.15", "Programming Language :: Python :: Implementation :: CPython", "Programming Language :: Python :: Implementation :: PyPy"], "description": "<p>\n  <a href=\"https://pypi.org/project/parver/\"><img src=\"https://img.shields.io/pypi/v/parver.svg\" alt=\"PyPI\" /></a>\n  <a href=\"https://parver.readthedocs.io/en/stable/\"><img src=\"https://img.shields.io/badge/docs-read%20now-blue.svg\" alt=\"Documentation Status\" /></a>\n  <a href=\"https://github.com/RazerM/parver/actions?workflow=CI\"><img src=\"https://github.com/RazerM/parver/actions/workflows/main.yml/badge.svg?branch=main\" alt=\"CI Status\" /></a>\n  <a href=\"https://codecov.io/gh/RazerM/parver\"><img src=\"https://codecov.io/gh/RazerM/parver/branch/main/graph/badge.svg\" alt=\"Test coverage\" /></a>\n  <a href=\"https://raw.githubusercontent.com/RazerM/parver/main/LICENSE\"><img src=\"https://img.shields.io/github/license/RazerM/parver.svg\" alt=\"MIT License\" /></a>\n</p>\n\n# parver\n\nparver allows parsing and manipulation of [PEP 440](https://www.python.org/dev/peps/pep-0440/) version numbers.\n\n# Example\n\n```python\n>>> Version.parse('1.3').bump_dev()\n<Version '1.3.dev0'>\n>>> v = Version.parse('v1.2.alpha-3')\n>>> v.is_alpha\nTrue\n>>> v.pre\n3\n>>> v\n<Version 'v1.2.alpha-3'>\n>>> v.normalize()\n<Version '1.2a3'>\n```\n", "description_content_type": "text/markdown", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": null, "home_page": null, "keywords": "parse, pep440, version", "license": null, "license_expression": "MIT", "license_files": ["LICENSE"], "maintainer": null, "maintainer_email": null, "name": "parver", "package_url": "https://pypi.org/project/parver/", "platform": null, "project_url": "https://pypi.org/project/parver/", "project_urls": {"Documentation": "https://parver.readthedocs.io", "Source Code": "https://github.com/RazerM/parver"}, "provides_extra": null, "release_url": "https://pypi.org/project/parver/1.0.1.post0/", "requires_dist": null, "requires_python": ">=3.10", "summary": "Parse and manipulate version numbers.", "version": "1.0.1.post0", "yanked": false, "yanked_reason": null}, "release_dates": {"0.1.0": "2018-05-19T23:08:43.674169Z", "0.1.1": "2018-06-19T20:07:41.075607Z", "0.2.0": "2018-11-20T23:40:47.181857Z", "0.2.1": "2018-12-31T02:50:53.883610Z", "0.3.0": "2020-02-20T23:00:30.313258Z", "0.3.1": "2020-09-28T20:11:42.557579Z", "0.4": "2022-11-11T21:29:52.093590Z", "0.5": "2023-10-03T21:06:52.796909Z", "1.0": "2026-05-19T22:30:33.343006Z", "1.0.1": "2026-07-30T12:25:15.397892Z", "1.0.1.post0": "2026-07-30T12:32:18.289417Z"}}
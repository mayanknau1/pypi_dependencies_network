{"info": {"author": null, "author_email": null, "bugtrack_url": null, "classifiers": [], "description": "This is an empty package that is required by pymupdf-2.x, in order to avoid\na pip bug that can result in a broken installation when upgrading from\npymupdf-1.x to pymupdf-2.x.\n\n[The pymupdf-2.x package now contains the 4llm code that used to be in\npymupdf4llm-1.x.]\n\nTo install pymupdf please do `pip install pymupdf`.\n\nCurrently the command `pip install pympdf4llm` will also install pymupdf,\nbut this is deprecated and will be disabled at some point in the future.\n\n", "description_content_type": "text/markdown", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": null, "home_page": null, "keywords": null, "license": null, "license_expression": null, "license_files": null, "maintainer": null, "maintainer_email": null, "name": "pymupdf4llm", "package_url": "https://pypi.org/project/pymupdf4llm/", "platform": null, "project_url": "https://pypi.org/project/pymupdf4llm/", "project_urls": null, "provides_extra": null, "release_url": "https://pypi.org/project/pymupdf4llm/2.1/", "requires_dist": ["pymupdf==2.1", "pymupdf_layout==2.1"], "requires_python": ">=3.11", "summary": null, "version": "2.1", "yanked": false, "yanked_reason": null}, "release_dates": {"0.0.1": "2024-04-24T21:24:11.046520Z", "0.0.10": "2024-07-21T11:44:19.376331Z", "0.0.11": "2024-08-22T17:02:12.395712Z", "0.0.12": "2024-08-23T10:36:28.662349Z", "0.0.13": "2024-08-31T23:08:49.369787Z", "0.0.14": "2024-09-04T20:14:01.994483Z", "0.0.15": "2024-09-16T09:59:20.982679Z", "0.0.16": "2024-09-16T13:23:28.552694Z", "0.0.17": "2024-09-21T18:40:01.033228Z", "0.0.18": "2025-03-24T09:36:35.475580Z", "0.0.19": "2025-03-29T13:24:19.824850Z", "0.0.2": "2024-05-20T17:52:38.402370Z", "0.0.20": "2025-04-04T19:47:43.786784Z", "0.0.21": "2025-04-08T20:36:47.426585Z", "0.0.22": "2025-04-28T09:18:54.694524Z", "0.0.23": "2025-05-09T15:35:44.327062Z", 
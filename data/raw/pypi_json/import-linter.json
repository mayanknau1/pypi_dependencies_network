{"info": {"author": null, "author_email": "David Seddon <david@seddonym.me>", "bugtrack_url": null, "classifiers": ["Development Status :: 5 - Production/Stable", "Intended Audience :: Developers", "License :: OSI Approved :: BSD License", "Operating System :: Microsoft :: Windows", "Operating System :: POSIX", "Operating System :: Unix", "Programming Language :: Python", "Programming Language :: Python :: 3.11", "Programming Language :: Python :: 3.12", "Programming Language :: Python :: 3.13", "Programming Language :: Python :: 3.14", "Programming Language :: Python :: 3.15", "Programming Language :: Python :: Free Threading :: 3 - Stable", "Programming Language :: Python :: Implementation :: CPython", "Topic :: Utilities"], "description": "<div align=\"center\">\n\n<img src=\"https://import-linter.readthedocs.io/en/stable/img/import-linter-logo-text-white.png\" alt=\"Import Linter\">\n\n**Lint your Python architecture.**\n\n[![Package version](https://img.shields.io/pypi/v/import-linter.svg)](https://pypi.org/project/import-linter)\n[![Python versions](https://img.shields.io/pypi/pyversions/import-linter.svg)](https://pypi.org/project/import-linter)\n[![CI status](https://github.com/import-linter/import-linter/actions/workflows/main.yml/badge.svg)](https://github.com/import-linter/import-linter/actions/workflows/main.yml)\n[![BSD license](https://img.shields.io/badge/License-BSD_2--Clause-orange.svg)](https://opensource.org/licenses/BSD-2-Clause)\n[![Codspeed](https://img.shields.io/endpoint?url=https://app.codspeed.io//badge.json)](https://app.codspeed.io//import-linter/import-linter?utm_source=badge)\n</div>\n\n\n**Import Linter** allows you to impose constraints on the imports between your Python modules.\n\nIt also provides a browser-based user interface for exploring the architecture of any Python package.\n\n<p align=\"center\">\n    <a href=\"https://import-linter.readthedocs.io/\">Get started</a>.\n</p>", "description_content_type": "text/markdown", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": null, "home_page": null, "keywords": null, "license": "BSD 2-Clause License", "license_expression": null, "license_files": ["LICENSE"], "maintainer": null, "maintainer_email": null, "name": "import-linter", "package_url": "https://pypi.org/project/import-linter/", "platform": null, "project_url": "https://pypi.org/project/import-linter/", "project_urls": {"Documentation": "https://import-linter.readthedocs.io/", "Source-code": "https://github.com/import-linter/import-linter/"}, "provides_extra": ["ui"], "release_url": "https://pypi.org/project/import-linter/2.17/", "requires_dist": ["click>=8.2.0", "grimp>=3.20", "rich>=14.2.0", "fastapi>=0.113; extra == \"ui\"", "typing-extensions>=4.10.0.0; extra == \"ui\"", "uvicorn>=0.17.1; extra == \"ui\""], "requires_python": ">=3.11", "summary": "Lint your Python architecture", "version": "2.17", "yanked": false, "yanked_reason": null}, "release_dates": {"1.0": "2019-10-17T07:35:24.713249Z", "1.0a1": "2019-01-27T11:12:14.147471Z", "1.0a2": "2019-03-26T09:07:17.890783Z", "1.0a3": "2019-03-27T13:18:54.481444Z", "1.0b1": "2019-04-06T15:23:57.850885Z", "1.0b2": "2019-04-16T16:58:49.063008Z", "1.0b3": "2019-05-15T11:53:08.461277Z", "1.0b4": "2019-07-03T18:59:24.217273Z", "1.0b5": "2019-10-05T11:28:21.938819Z", "1.1": "2020-06-29T09:04:15.261560Z", "1.10.0": "2023-07-06T17:00:22.986011Z", "1.11.0": "2023-08-18T08:50:29.082372Z", "1.11.1": "2023-08-21T10:36:28.363171Z", "1.11b1": "2023-08-17T16:51:38.658310Z", "1.12.0": "2023-09-24T16:22:01.715268Z", "1.12.1": "2023-10-30T12:30:51.936036Z", "1.1b1": "2019-11-24T12:40:21.715337Z", "1.1b2": "2019-11-27T18:25:40.194095Z", "1.2": "2020-09-23T10:24:56.198969Z", "1.2.1": "2021-01-22T09:15:48.743751Z", "1.2.2": "2021-07-13T14:09:23.143691Z", "1.2.3": "2021-07-29T10:30:38.421765Z", "1.2.4": "2021-08-09T07:51:25.457009Z", "1.2.5": "2021-09-21T09:37:59.930346Z", "1.2.6": "2021-09-24
{"info": {"author": "Alexey Ignatiev, Joao Marques-Silva, Antonio Morgado", "author_email": "alexey.ignatiev@monash.edu, joao.marques-silva@univ-toulouse.fr, ajrmorgado@gmail.com", "bugtrack_url": null, "classifiers": [], "description": "\nA Python library providing a simple interface to a number of state-of-art\nBoolean satisfiability (SAT) solvers and a few types of cardinality and\npseudo-Boolean encodings. The purpose of PySAT is to enable researchers\nworking on SAT and its applications and generalizations to easily prototype\nwith SAT oracles in Python while exploiting incrementally the power of the\noriginal low-level implementations of modern SAT solvers.\n\nWith PySAT it should be easy for you to implement a MaxSAT solver, an\nMUS/MCS extractor/enumerator, or any tool solving an application problem\nwith the (potentially multiple) use of a SAT oracle.\n\nDetails can be found at `https://pysathq.github.io <https://pysathq.github.io>`__.\n", "description_content_type": "text/x-rst; charset=UTF-8", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": ["Author", "Author-Email", "Description", "Description-Content-Type", "Home-Page", "License", "License-File", "Provides-Extra", "Requires-Dist", "Summary"], "home_page": "https://github.com/pysathq/pysat", "keywords": null, "license": "MIT", "license_expression": null, "license_files": ["LICENSE.txt"], "maintainer": null, "maintainer_email": null, "name": "python-sat", "package_url": "https://pypi.org/project/python-sat/", "platform": null, "project_url": "https://pypi.org/project/python-sat/", "project_urls": {"Homepage": "https://github.com/pysathq/pysat"}, "provides_extra": ["aiger", "approxmc", "cryptosat", "pb", "pblib", "unigen"], "release_url": "https://pypi.org/project/python-sat/1.9.dev24/", "requires_dist": ["six", "py-aiger-cnf>=2.0.0; extra == \"aiger\"", "pyapproxmc>=4.1.8; extra == \"approxmc\"", "pycryptosat>=5.11.18; extra == \"cryptosat\"", "pindakaas>=0.6.1; extra == \"pb\"", "pindakaas>=0.6.1; extra == \"pblib\"", "pyunigen>=4.1.20; extra == \"unigen\""], "requires_python": null, "summary": "A Python library for prototyping with SAT oracles", "version": "1.9.dev24", "yanked": false, "yanked_reason": null}, "release_dates": {"0.1.1dev3": "2018-01-28T17:49:34.597810Z", "0.1.1dev4": "2018-01-28T18:35:03.926813Z", "0.1.1dev5": "2018-01-30T10:27:58.002102Z", "0.1.1dev6": "2018-01-31T10:44:47.381638Z", "0.1.1dev7": "2018-01-31T10:59:54.413312Z", "0.1.1dev8": "2018-02-22T17:26:44.589233Z", "0.1.1dev9": "2018-03-01T18:35:00.871553Z", "0.1.2dev0": "2018-03-02T14:54:45.801376Z", "0.1.2dev1": "2018-03-02T16:13:26.214577Z", "0.1.2dev2": "2018-03-04T09:27:00.566664Z", "0.1.2dev3": "2018-03-06T17:50:25.656920Z", "0.1.2dev4": "2018-03-25T00:20:56.772852Z", "0.1.2dev5": "2018-03-28T10:25:09.346266Z", "0.1.2dev6": "2018-03-29T20:01:08.797926Z", "0.1.2dev7": "2018-04-03T08:51:55.745570Z", "0.1.2dev8": "2018-04-06T17:08:36.501453Z", "0.1.2dev9": "2018-04-08T10:43:57.577269Z", "0.1.3.dev10": "2018-06-07T11:39:55.268716Z", "0.1.3.dev11": "2018-06-20T13:38:51.808361Z", "0.1.3.dev12": "2018-07-16T21:22:00.555557Z", "0.1.3.dev13": "2018-07-27T22:46:49.672303Z", "0.1.3.dev14": "2018-08-17T09:44:40.192390Z", "0.1.3.dev15": "2018-08-19T07:13:05.110501Z", "0.1.3.dev16": "2018-08-20T11:35:22.975448Z", "0.1.3.dev17": "2018-08-25T10:52:42.283702Z", "0.1.3.dev18": "2018-08-25T11:59:49.663553Z", "0.1.3.dev19": "2018-08-25T21:44:55.574070Z", "0.1.3.dev20": "2018-08-30T06:51:50.563610Z", "0.1.3.dev21": "2018-09-06T08:00:16.377132Z", "0.1.3.dev22": "2018-09-20T21:12:18.585852Z", "0.1.3.dev23": "2018-09-22T16:59:43.160212Z", "0.1.3.dev24": "2018-11-01T22:14:22.394888Z", "0.1.3.dev25": "2018-12-28T23:28:59.952610Z", "0.1.3.dev8": "2018-05-25T11:06:52.116942Z", "0.1.3.dev9": "2018-05-28T15:47:21.333597Z", "0.1.3dev0": "2018-04-09T22:08:29.743220Z", "0.1.3dev1": "2018-04-10T16:31:07.990568Z", "0.1.3dev2": "2018-05-02T13:21:36.458484
erating and working with LinkML. For the LinkML schema (metamodel), please see https://github.com/linkml/linkml-model\n\nThe complete documentation for LinkML can be found here:\n\n - [linkml.io/linkml](https://linkml.io/linkml)\n", "description_content_type": "text/markdown", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": null, "home_page": null, "keywords": "biolink, data modeling, linked data, owl, rdf, schema", "license": null, "license_expression": "Apache-2.0", "license_files": null, "maintainer": null, "maintainer_email": null, "name": "linkml", "package_url": "https://pypi.org/project/linkml/", "platform": null, "project_url": "https://pypi.org/project/linkml/", "project_urls": null, "provides_extra": null, "release_url": "https://pypi.org/project/linkml/1.12.1/", "requires_dist": ["antlr4-python3-runtime<4.10,>=4.9.0", "click>=8.3.3", "graphviz>=0.10.1", "hbreader", "isodate>=0.6.0", "jinja2>=3.1.0", "jsonasobj2<2.0.0,>=1.0.3", "jsonschema[format]>=4.26.0", "linkml-runtime<2.0.0,>=1.12.0", "openapi-spec-validator>=0.8.4", "openpyxl", "parse", "platformdirs>=4.12.2", "prefixcommons>=0.1.7", "prefixmaps>=0.2.2", "pydantic-settings>=2.15.0", "pydantic<3.0.0,>=2.13.5", "pyjsg>=0.12.3", "pyshex>=0.9.0", "pyshexc>=0.10.3", "python-dateutil", "pyyaml", "rdflib>=7.6.0", "requests>=2.22", "sphinx-click>=6.0.0", "sqlalchemy>=2.0.54", "typing-extensions>=4.6.0; python_version < \"3.12\"", "watchdog>=0.9.0"], "requires_python": ">=3.10", "summary": "Linked Open Data Modeling Language", "version": "1.12.1", "yanked": false, "yanked_reason": null}, "release_dates": {"0.0.0": "2021-09-20T20:26:05.050654Z", "0.0.2": "2021-03-24T16:02:49.473964Z", "0.0.4": "2021-03-24T18:59:21.318232Z", "0.0.5": "2021-03-26T15:56:22.342690Z", "0.0.6": "2021-03-30T16:03:34.622794Z", "0.0.7": "2021-04-05T23:00:55.778018Z", "0.1.0.dev4": "2021-05-13T19:27:02.467684Z", "0.1.1.dev1": "2021-05-10T21:39:22.466985Z", "0.1.1.dev2"
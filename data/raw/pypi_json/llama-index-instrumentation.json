{"info": {"author": null, "author_email": "Massimiliano Pippi <mpippi@gmail.com>", "bugtrack_url": null, "classifiers": [], "description": "# LlamaIndex Instrumentation\n\nThis project provides the instrumentation hooks for observability in LlamaIndex.\n\nInstrumentation uses a mix of\n\n- spans\n- events\n- dispatchers that manage span and event handlers\n\nFor more in-depth usage, you can see an example [in the workflows repo](https://github.com/run-llama/workflows-py/tree/main/examples/observability).\n\nFor other documentation, you can see the [LlamaIndex documentation](https://developers.llamaindex.ai/python/framework/module_guides/observability/instrumentation/).\n", "description_content_type": "text/markdown", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": null, "home_page": null, "keywords": null, "license": null, "license_expression": "MIT", "license_files": null, "maintainer": null, "maintainer_email": null, "name": "llama-index-instrumentation", "package_url": "https://pypi.org/project/llama-index-instrumentation/", "platform": null, "project_url": "https://pypi.org/project/llama-index-instrumentation/", "project_urls": {"Documentation": "https://developers.llamaindex.ai/python/framework/module_guides/observability/instrumentation/", "Homepage": "https://llamaindex.ai", "Repository": "https://github.com/run-llama/llama_index/tree/main/llama-index-instrumentation"}, "provides_extra": null, "release_url": "https://pypi.org/project/llama-index-instrumentation/0.6.0/", "requires_dist": ["deprecated>=1.2.18", "pydantic>=2.11.5"], "requires_python": "<4.0,>=3.10", "summary": "Instrumentation and Observability for LlamaIndex", "version": "0.6.0", "yanked": false, "yanked_reason": null}, "release_dates": {"0.1.0": "2025-06-09T15:41:29.822283Z", "0.2.0": "2025-06-20T15:50:04.381853Z", "0.3.0": "2025-07-17T17:41:19.723410Z", "0.3.1": "2025-07-30T14:11:14.269232Z", "0.4.0": "2025-07-30T21:02:25.95
{"info": {"author": "Brian Olson", "author_email": "bolson@bolson.org", "bugtrack_url": null, "classifiers": ["Development Status :: 5 - Production/Stable", "Intended Audience :: Developers", "License :: OSI Approved :: Apache Software License", "Operating System :: OS Independent", "Programming Language :: C", "Programming Language :: Python :: 2.7", "Programming Language :: Python :: 3.4", "Programming Language :: Python :: 3.5", "Topic :: Software Development :: Libraries :: Python Modules"], "description": "An implementation of RFC 7049 - Concise Binary Object Representation (CBOR).\n\nCBOR is comparable to JSON, has a superset of JSON's ability, but serializes to a binary format which is smaller and faster to generate and parse.\n\nThe two primary functions are cbor.loads() and cbor.dumps().\n\nThis library includes a C implementation which runs 3-5 times faster than the Python standard library's C-accelerated implementanion of JSON. This is also includes a 100% Python implementation.", "description_content_type": null, "docs_url": null, "download_url": "UNKNOWN", "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": null, "home_page": "https://bitbucket.org/bodhisnarkva/cbor", "keywords": null, "license": "Apache", "license_expression": null, "license_files": null, "maintainer": null, "maintainer_email": null, "name": "cbor", "package_url": "https://pypi.org/project/cbor/", "platform": "UNKNOWN", "project_url": "https://pypi.org/project/cbor/", "project_urls": {"Download": "UNKNOWN", "Homepage": "https://bitbucket.org/bodhisnarkva/cbor"}, "provides_extra": null, "release_url": "https://pypi.org/project/cbor/1.0.0/", "requires_dist": null, "requires_python": null, "summary": "RFC 7049 - Concise Binary Object Representation", "version": "1.0.0", "yanked": false, "yanked_reason": null}, "release_dates": {"0.1": "2014-01-04T22:14:56.489855Z", "0.1.1": "2014-01-04T22:29:53.679128Z", "0.1.10": "2014-08-21T15:37:47.107462Z", "0.1.11": "2014-09-
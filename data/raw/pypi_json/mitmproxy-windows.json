{"info": {"author": null, "author_email": null, "bugtrack_url": null, "classifiers": [], "description": "# mitmproxy-windows\n\nThis package contains the following precompiled binaries for Windows:\n \n - `windows-redirector.exe`: A Rust executable that redirects traffic to mitmproxy via a Windows named pipe.\n - A vendored copy of [WinDivert](https://reqrypt.org/windivert.html), used by the redirector.\n\n\n## Redirector Development Setup\n\n1. Run `pip install -e .` to install `mitmproxy_windows` as editable.\n2. Run something along the lines of `mitmdump --mode local:curl`.  \n   You should see a `Development mode: Compiling windows-redirector.exe...` message.\n", "description_content_type": "text/markdown", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": null, "home_page": null, "keywords": null, "license": null, "license_expression": "LGPL-3.0-or-later", "license_files": null, "maintainer": null, "maintainer_email": null, "name": "mitmproxy-windows", "package_url": "https://pypi.org/project/mitmproxy-windows/", "platform": null, "project_url": "https://pypi.org/project/mitmproxy-windows/", "project_urls": {"Source": "https://github.com/mitmproxy/mitmproxy-rs"}, "provides_extra": null, "release_url": "https://pypi.org/project/mitmproxy-windows/0.12.16/", "requires_dist": null, "requires_python": ">=3.12", "summary": null, "version": "0.12.16", "yanked": false, "yanked_reason": null}, "release_dates": {"0.10.0": "2024-10-27T12:02:44.598414Z", "0.10.1": "2024-10-27T13:45:15.841516Z", "0.10.2": "2024-10-27T14:22:20.345887Z", "0.10.3": "2024-10-27T14:54:05.630226Z", "0.10.4": "2024-10-27T15:47:33.130705Z", "0.10.5": "2024-10-27T15:59:02.338694Z", "0.10.6": "2024-10-28T07:31:53.085062Z", "0.10.7": "2024-10-28T11:56:37.868112Z", "0.11.1": "2024-12-11T00:22:13.987414Z", "0.11.2": "2025-01-03T01:03:40.050623Z", "0.11.3": "2025-01-05T16:07:03.743212Z", "0.11.4": "2025-01-06T08:54:53.274192Z", "0.11.5": 
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">An empirical comparison of dependency network evolution in seven software packaging ecosystems</rdf:li>
            </rdf:Alt>
         </dc:title>
